{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT-dlp",
  "version": "1.0.0",
  "identifier": "com.dangjimmy.ytdlp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YT-dlp GUI - Ultimate Media Downloader",
        "width": 1080,
        "height": 720,
        "minWidth": 920,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#030712",
        "shadow": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "dialog": null,
    "notification": null,
    "opener": null,
    "shell": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
